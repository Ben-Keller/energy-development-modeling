# Secret/local values only. Do not commit real credentials.
# Non-secret EDIM runtime defaults live in inputs/runtime_config.json.

# ---------------------------------------------------------------------------
# Local Docker Compose overrides (docker-compose-dev.yml)
# ---------------------------------------------------------------------------
EDIM_API_PORT=8000
EDIM_DB_PORT=5432
EDIM_AZURITE_BLOB_PORT=10000
EDIM_SERVICEBUS_PORT=5672

EDIM_DB_USER=edim
EDIM_DB_PASSWORD=edim
EDIM_DB_NAME=edim_db_local

EDIM_SERVICEBUS_SQL_PASSWORD=StrongPassword123
EDIM_SERVICEBUS_QUEUE_NAME=execution-queue-local

# develop branch uses the X-EDIM-User-Id test-header shim (plan 1.4)
EDIM_AUTH_MODE=test_header
EDIM_TEST_USER_ID=dev-user-1

EDIM_WORKER_ID=edim-worker-01
# Use 'directory' to poll ./outputs/worker-inbox for bundles, or 'servicebus' for emulator.
EDIM_WORKER_MODE=directory

# ---------------------------------------------------------------------------
# Azure OpenAI / OpenAI query planner
# For Azure OpenAI, set AZURE_OPENAI_ENDPOINT plus either AZURE_OPENAI_API_KEY or OPENAI_API_KEY.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
OPENAI_API_BASE=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-local-secret
AZURE_OPENAI_DEPLOYMENT=replace-with-deployment-name
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Backward-compatible names also supported by the app.
OPENAI_API_KEY=replace-with-local-secret
OPENAI_FILTER_MODEL=replace-with-model-or-azure-deployment
