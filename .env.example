# Required paths
EDIM_CALLIOPE_ROOT=./Calliope-Africa-main
EDIM_RUNS_DIR=./outputs/runs
EDIM_CONFIG_DIR=./inputs
EDIM_FRONTEND_DIR=./frontend

# Core runtime
EDIM_SOLVER=highs
EDIM_ALLOW_FULL_YEAR=true
EDIM_DEV_SUBSET_START=2019-01-01
EDIM_DEV_SUBSET_END=2019-01-02
EDIM_ANALYSIS_SUBSET_START=2019-01-01
EDIM_ANALYSIS_SUBSET_END=2019-03-31
EDIM_DEV_SOLVER_TIME_LIMIT_SECONDS=3600
EDIM_ANALYSIS_SOLVER_TIME_LIMIT_SECONDS=14400
EDIM_SUMMARY_MAX_GENERATION_TECHS=40
EDIM_SUMMARY_MAX_GENERATION_TIMESTEPS=240
EDIM_SUMMARY_MAX_CATEGORY_ROWS=100
EDIM_SUMMARY_DIAGNOSTICS_MAX_ROWS=200
EDIM_CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Development engine runtime
EDIM_DEVELOPMENT_ENGINE=mario
EDIM_MARIO_DB_PATH=
EDIM_MARIO_TIMEOUT_SECONDS=120
EDIM_MARIO_FAIL_ON_ERROR=false
