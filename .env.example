# Secret/local values only. Do not commit real credentials.
# Non-secret EDIM runtime defaults live in inputs/runtime_config.json.

# Optional local service overrides.
# EDIM_FRONTEND_DIR=/absolute/path/to/frontend
# EDIM_RUNS_DIR=/absolute/path/to/outputs/runs
# EDIM_PLATFORM_SQLITE_PATH=/absolute/path/to/outputs/platform/platform.sqlite3

# Optional public frontend runtime target used by the Local/Backend switch.
# This is not a secret; it should be the hosted API base URL.
# EDIM_BACKEND_API_BASE=https://your-hosted-backend.example.org
