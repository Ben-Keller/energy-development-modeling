{
  "name": "edim-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend shell modules for the EDIM modeling dashboard.",
  "scripts": {
    "build": "npm run check && node scripts/build-static.js",
    "check": "node scripts/build-static.js --check",
    "start": "python3 -m http.server 4173 --directory dist",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/standalone": "^7.26.0",
    "@playwright/test": "^1.62.0",
    "@turf/turf": "^6.5.0",
    "d3-delaunay": "^6.0.4",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0"
  }
}
