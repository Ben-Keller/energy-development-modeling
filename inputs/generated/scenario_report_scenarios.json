  "calibration_steps": [
    {
      "action": "Extract baseline energy shares",
      "notes": "Query Exiobase 2021 Z-matrix output shares for each electricity sector in each target region",
      "step": "1"
    },
    {
      "action": "Compute fossil share",
      "notes": "Sum coal+gas+oil electricity as % of total electricity output for each region",
      "step": "2"
    },
    {
      "action": "Derive shock multipliers",
      "notes": "Shock = (target share / baseline share); if target = 0, use New Value = 0 mode",
      "step": "3"
    },
    {
      "action": "Apply reallocation",
      "notes": "Reduction in fossil coefficients must sum to increase in renewable coefficients (row sums preserved)",
      "step": "4"
    },
    {
      "action": "Validate satellite accounts",
      "notes": "Verify CO2 intensity reductions are proportional to fossil share reduction",
      "step": "5"
    },
    {
      "action": "Run model and check Leontief inverse",
      "notes": "Ensure no negative outputs; check Leontief stability conditions",
      "step": "6"
