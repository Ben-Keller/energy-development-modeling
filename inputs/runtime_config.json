{
  "paths": {
    "calliope_root": "./Calliope-Africa-main",
    "runs_dir": "./outputs/runs",
    "config_dir": "./inputs",
    "frontend_dir": "./frontend"
  },
  "runtime": {
    "solver": "highs",
    "allow_full_year": true,
    "dev_subset_start": "2019-01-01",
    "dev_subset_end": "2019-01-02",
    "analysis_subset_start": "2019-01-01",
    "analysis_subset_end": "2019-03-31",
    "dev_solver_time_limit_seconds": 3600,
    "analysis_solver_time_limit_seconds": 14400,
    "cors_allow_origins": ["http://localhost:8000", "http://127.0.0.1:8000"]
  },
  "summary": {
    "max_generation_techs": 40,
    "max_generation_timesteps": 240,
    "max_category_rows": 100,
    "diagnostics_max_rows": 200
  },
  "runs": {
    "retention_days": 30,
    "max_dirs": 200
  },
  "jobs": {
    "history_limit": 200,
    "dedupe_enabled": true,
    "queue_capacity": 200
  },
  "development_engine": {
    "engine": "mario",
    "mario_db_path": "",
    "mario_timeout_seconds": 120,
    "mario_fail_on_error": false
  },
  "ai": {
    "provider": "azure_openai",
    "azure_api_version": "2025-01-01-preview",
    "model_env": "OPENAI_FILTER_MODEL",
    "required_secret_env": ["OPENAI_API_KEY"],
    "optional_secret_env": ["AZURE_OPENAI_ENDPOINT", "AZURE_OPENAI_API_KEY", "AZURE_OPENAI_DEPLOYMENT", "AZURE_OPENAI_API_VERSION"]
  }
}
