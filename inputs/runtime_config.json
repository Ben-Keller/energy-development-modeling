{
  "paths": {
    "calliope_root": "./model_runtime/model_modules/calliope/Calliope-Africa-main",
    "runs_dir": "./outputs/runs",
    "config_dir": "./inputs",
    "frontend_dir": "./frontend"
  },
  "storage": {
    "platform_store_backend": "sqlite",
    "platform_sqlite_path": "./outputs/platform/platform.sqlite3"
  },
  "runtime": {
    "solver": "highs",
    "allow_full_year": true,
    "dev_subset_start": "2019-01-01",
    "dev_subset_end": "2019-01-02",
    "analysis_subset_start": "2019-01-01",
    "analysis_subset_end": "2019-03-31",
    "dev_solver_time_limit_seconds": 3600,
    "analysis_solver_time_limit_seconds": 14400,
    "cors_allow_origins": [
      "http://localhost:8000",
      "http://127.0.0.1:8000",
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "http://localhost:4174",
      "http://127.0.0.1:4174",
      "http://localhost:4175",
      "http://127.0.0.1:4175",
      "http://localhost:4176",
      "http://127.0.0.1:4176",
      "http://localhost:4177",
      "http://127.0.0.1:4177",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5174",
      "http://localhost:5175",
      "http://127.0.0.1:5175",
      "http://localhost:5176",
      "http://127.0.0.1:5176",
      "http://localhost:5177",
      "http://127.0.0.1:5177"
    ]
  },
  "summary": {
    "max_generation_techs": 40,
    "max_generation_timesteps": 240,
    "max_category_rows": 100,
    "diagnostics_max_rows": 200
  },
  "runs": {
    "retention_days": 30,
    "max_dirs": 200
  },
  "jobs": {
    "history_limit": 200,
    "dedupe_enabled": true,
    "queue_capacity": 12,
    "execution_max_attempts": 1
  },
  "development_engine": {
    "engine": "mario",
    "mario_db_path": "",
    "mario_timeout_seconds": 120,
    "mario_fail_on_error": false
  },
