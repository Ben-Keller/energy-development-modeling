      "shortLabel": "Energy + development",
      "description": "Full EDIM architecture linking the energy model to bridge outputs and MRIO/development impacts.",
      "requiresMrio": true,
      "requiresBridge": true,
      "enabledDatasetLayers": [
        "calliope",
        "scenario",
        "mrio",
        "bridge"
      ],
